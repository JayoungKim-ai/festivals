# 공공데이터포털 - 전국문화축제표준데이터 API
# 이 파일을 복사해 .env 를 만든 뒤, 실제 인증키를 넣으세요.
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (macOS/Linux)

# 공공데이터 API 인증키 (data.go.kr 발급) — 실제 값은 .env 에만 보관
FESTIVAL_API_KEY=

# API 요청 URL (docs/API.md 기준)
FESTIVAL_API_BASE_URL=https://api.data.go.kr/openapi/tn_pubr_public_cltur_fstvl_api

# 응답 형식: json | xml (클라이언트 구현 시 json 권장)
FESTIVAL_API_TYPE=json

# 한 페이지 결과 수 (API 최대 1000)
FESTIVAL_API_NUM_OF_ROWS=100
